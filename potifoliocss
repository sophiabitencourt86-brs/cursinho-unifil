{
    margin: 0px;
    padding: 0;
    font-family: poppins;
    box-sizing: border-box;
    }
    
    .cabecalho {
    display: flex;
    background-color: #152238;
    height: 40px;
    justify-content: space-between;
    align-items: center;
    padding: 30px;
    }

    #fotominha{
        width: 200px;
        border-radius: 50%;
        height: 200px;
    }
    
    .links {
    display: flex;
    gap: 50px;
    }
    
    a {
    text-decoration: none;
    font-size: 20px;
    color: white;
    }
    
    #nome-loja {
    color: white;
    font-size: 30px;
    }
    
    .banner {
    background-color: #f5efb6;
    height: 40vh;
    text-align: center;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center; 
    gap: 10px;
    border-radius: 50%;
    }
    
    .banner h2 {
    font-size: 40px;
    }
    
    .botao {
    padding: 10px;
    border: none;
    border-radius: 5px;
    color: rgb(226, 212, 133);
    cursor: pointer;
    }
    
    .produto {
    border: 2px solid black;
    border-radius: 10px;
    width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    min-height: 450px;
    transition: 0.5s;
    }
    
    .produto p {
    text-align: center;
    }
    
    .produto img {
    width: 200px;
    height: 180px;
    }
    
    .produto button {
    padding: 10px;
    width: 80%;
    cursor: pointer;
    background-color: #2563eb;
    color: white;
    font-weight: bold;
    border-style: none;
    border-radius: 10px;
    transition: 0.5s;
    }
    
    .produto button:hover {
    transform: scale(1.01);
    }
    
    .produto:hover {
    transform: scale(1.01);
    }
    
    .preco {
    color: #2563eb;
    font-weight: bold;
    }
    
    .produtos {
    display: flex;
    gap: 40px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 980px;
    margin: 0 auto;
    }
    
    .catalogo {
    padding: 60px 8%;
    }
    
    .catalogo h2 {
    text-align: center;
    }
    
    .rodape {
    background-color: #152238;
    display: flex;
    justify-content: space-between;
    padding: 40px 8%;
    }
    
    .rodape h3 {
    color: #2563eb;
    }
    
    .rodape p {
    color: white;
    }
